{
 "datasets": [
  {
   "name": "ds_resumo",
   "displayName": "Resumo da carga diária",
   "queryLines": [
    "SELECT\n",
    "  (SELECT count(*) FROM execucoes_job WHERE job = 'pos_venda_carga_diaria') AS execucoes_carga,\n",
    "  (SELECT execucoes_base FROM linha_base WHERE tipo = 'job' AND job = 'pos_venda_carga_diaria') AS execucoes_base,\n",
    "  (SELECT mediana_min FROM linha_base WHERE tipo = 'job' AND job = 'pos_venda_carga_diaria') AS mediana_min,\n",
    "  (SELECT p95_min FROM linha_base WHERE tipo = 'job' AND job = 'pos_venda_carga_diaria') AS p95_min,\n",
    "  (SELECT folga_projetada_min FROM ultima_execucao WHERE job = 'pos_venda_carga_diaria') AS folga_projetada_min,\n",
    "  (SELECT count(*) FROM desvios WHERE dia_local >= date_sub(current_date(), 30) AND job IN ('pos_venda_carga_diaria', 'pos_venda_carga_silver_lakeflow')) AS desvios_30d,\n",
    "  (SELECT count(*) FROM alerta_sustentacao) AS ocorrencias_alerta\n"
   ]
  },
  {
   "name": "ds_tarefas",
   "displayName": "Duração por tarefa em cada execução da carga",
   "queryLines": [
    "SELECT date_format(e.inicio_local, 'yyyy-MM-dd HH:mm') AS execucao, t.tarefa,\n",
    "  t.duracao_min, t.setup_s, t.execucao_s, t.resultado\n",
    "FROM execucoes_tarefa t JOIN execucoes_job e ON e.job_run_id = t.job_run_id\n",
    "WHERE t.job = 'pos_venda_carga_diaria' AND t.resultado <> 'SKIPPED'\n",
    "ORDER BY execucao, t.inicio\n"
   ]
  },
  {
   "name": "ds_base",
   "displayName": "Linha de base por tarefa",
   "queryLines": [
    "SELECT tipo, tarefa, execucoes_base, mediana_min, p95_min, round(limite_desvio_s / 60, 2) AS limite_min,\n",
    "  mediana_setup_s, mediana_execucao_s, CASE WHEN base_suficiente THEN 'sim' ELSE 'não (poucas execuções)' END AS base_vale\n",
    "FROM linha_base\n",
    "WHERE job = 'pos_venda_carga_diaria' OR (tipo = 'pipeline' AND job = 'pos_venda_carga_silver_lakeflow')\n",
    "ORDER BY CASE tipo WHEN 'job' THEN 0 WHEN 'pipeline' THEN 2 ELSE 1 END, mediana_min DESC\n"
   ]
  },
  {
   "name": "ds_volume",
   "displayName": "Volume × duração por execução",
   "queryLines": [
    "SELECT inicio_local, concat(dias_processados, CASE WHEN dias_processados = 1 THEN ' dia' ELSE ' dias' END) AS intervalo,\n",
    "  dias_processados, eventos_gravados, linhas_fato_gravadas, duracao_min, setup_s, segundos_por_dia_processado\n",
    "FROM volume_execucao WHERE sucesso ORDER BY inicio_local\n"
   ]
  },
  {
   "name": "ds_desvios",
   "displayName": "Desvios",
   "queryLines": [
    "SELECT inicio_local, tipo, tarefa, job, round(duracao_s / 60, 2) AS duracao_min, round(mediana_base_s / 60, 2) AS mediana_min,\n",
    "  round(p95_base_s / 60, 2) AS p95_min, round(excesso_s / 60, 2) AS excesso_min, acima_mediana_pct, execucoes_base, provavel_causa\n",
    "FROM desvios WHERE job IN ('pos_venda_carga_diaria', 'pos_venda_carga_silver_lakeflow') ORDER BY inicio_local DESC\n"
   ]
  },
  {
   "name": "ds_sla",
   "displayName": "SLA diário",
   "queryLines": [
    "SELECT dia, job, hora_agenda, hora_meta, situacao, execucoes_agenda, execucoes_manuais, fim_agenda_local, atraso_min\n",
    "FROM sla_diario ORDER BY dia DESC\n"
   ]
  },
  {
   "name": "ds_pipeline",
   "displayName": "Updates do pipeline",
   "queryLines": [
    "SELECT date_format(inicio_local, 'yyyy-MM-dd HH:mm') AS update_local, round(espera_s / 60, 2) AS espera_min, duracao_min,\n",
    "  resultado, refresh_completo\n",
    "FROM atualizacoes_pipeline WHERE pipeline = 'pos_venda_carga_silver_lakeflow' ORDER BY update_local\n"
   ]
  },
  {
   "name": "ds_matriz",
   "displayName": "Matriz por tarefa",
   "queryLines": [
    "SELECT ordem, tarefa, mediana_min, p95_min, ultima_situacao, sintoma_falha, acao_falha, sintoma_lentidao, acao_lentidao, referencia\n",
    "FROM matriz_tarefas ORDER BY ordem\n"
   ]
  },
  {
   "name": "ds_ultima",
   "displayName": "Última execução por job",
   "queryLines": [
    "SELECT job, inicio_local, duracao_min, resultado, gatilho, mediana_min, p95_min, acima_mediana_min, hora_agenda,\n",
    "  CASE WHEN agenda_pausada THEN 'pausada' WHEN hora_agenda IS NULL THEN 'sem agenda' ELSE 'ligada' END AS agenda, hora_meta, atraso_meta_min,\n",
    "  folga_projetada_min, timeout_min, timeout_sugerido_min, dias_desde_ultima\n",
    "FROM ultima_execucao ORDER BY inicio_local DESC NULLS LAST\n"
   ]
  },
  {
   "name": "ds_alerta",
   "displayName": "Ocorrências para o alerta",
   "queryLines": [
    "SELECT tipo_ocorrencia, job, tarefa, quando_local, detalhe, acao FROM alerta_sustentacao ORDER BY quando_local DESC\n"
   ]
  }
 ],
