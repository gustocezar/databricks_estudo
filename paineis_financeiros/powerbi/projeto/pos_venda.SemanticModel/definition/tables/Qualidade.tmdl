/// Qualidade diária dos eventos do sistema de origem.
table Qualidade
	lineageTag: 10aca29d-9e85-5317-8749-20eb85b7a937

	/// Eventos recebidos do sistema de origem.
	measure 'Eventos recebidos' = SUM ( 'Qualidade'[eventos_recebidos] )
		formatString: #,0
		displayFolder: Qualidade
		lineageTag: 66b90a18-6b6a-53c8-92bd-a6460d3c0771

	/// Passaram na barreira e entraram nos números.
	measure 'Eventos aptos' = SUM ( 'Qualidade'[eventos_aptos] )
		formatString: #,0
		displayFolder: Qualidade
		lineageTag: 9f939c52-793a-5bdb-a22d-a3e300b8b790

	/// Foram para a quarentena e não entram nos números.
	measure 'Eventos barrados' = SUM ( 'Qualidade'[eventos_barrados] )
		formatString: #,0
		displayFolder: Qualidade
		lineageTag: b0db1ef2-f13c-53b9-bf55-f386e164e391

	measure 'Eventos duplicados' = SUM ( 'Qualidade'[eventos_duplicados] )
		formatString: #,0
		displayFolder: Qualidade
		lineageTag: 4cbe3933-053b-51d5-ae91-2bc9de9bb68a

	/// Aviso.
	measure 'E-mail ausente' = SUM ( 'Qualidade'[email_ausente] )
		formatString: #,0
		displayFolder: Qualidade
		lineageTag: 46fb2a80-55d1-5a21-be20-c28446e4b709

	/// Aviso (contagem; não contém CPF).
	measure 'CPF inválido' = SUM ( 'Qualidade'[cpf_invalido] )
		formatString: #,0
		displayFolder: Qualidade
		lineageTag: 68a158b2-c508-5d50-be45-5b922b14f355

	/// Aviso.
	measure 'CEP malformado' = SUM ( 'Qualidade'[cep_malformado] )
		formatString: #,0
		displayFolder: Qualidade
		lineageTag: a7a44eae-1e60-5347-aee5-f7897c2e2713

	/// Eventos aptos com forma fora do catálogo.
	measure 'Forma de pagamento não cadastrada' = SUM ( 'Qualidade'[forma_pagamento_nao_cadastrada] )
		formatString: #,0
		displayFolder: Qualidade
		lineageTag: 7a82b28c-6776-56b1-a17c-85df410e4f49

	/// Barrados / recebidos.
	measure 'Taxa de barrados' = DIVIDE ( [Eventos barrados], [Eventos recebidos] )
		formatString: 0.0%
		displayFolder: Qualidade
		lineageTag: 0c3961b7-60df-5169-a954-ffe0e00e1ec5

